@model IntergratedProject.Models.Payment

@{
    ViewData["Title"] = "Payment Confirmation";
}

<h2>Payment Confirmation</h2>

<div class="alert alert-success">
    <strong>Payment Status:</strong> @Model.PaymentStatus
</div>

<div class="card p-3">
    <p><strong>Pet:</strong> @Model.Appointment.Pet.PetName</p>
    <p><strong>Appointment Type:</strong> @Model.Appointment.AppointmentType.Name</p>
    <p><strong>Date:</strong> @Model.Appointment.Date.ToShortDateString()</p>
    <p><strong>Time:</strong> @Model.Appointment.Time</p>
    <p><strong>Amount Paid:</strong> R@Model.Amount</p>
    <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>
    <p><strong>Transaction Reference:</strong> @Model.TransactionReference</p>
    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <p><strong>Notes:</strong> @Model.Notes</p>
    }
</div>

<a asp-controller="Appointments" asp-action="Index" class="btn btn-secondary mt-3">Back to Appointments</a>
