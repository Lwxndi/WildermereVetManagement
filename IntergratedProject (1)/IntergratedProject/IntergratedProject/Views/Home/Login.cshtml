@model IntergratedProject.ViewModels.LoginViewModel

<link rel="stylesheet" href="~/css/login.css" />

<div class="background-overlay"></div> <!-- Transparent overlay -->

<div class="login-wrapper">
    <div class="main-container">
        <div class="content-panel left-panel">
            <h1>Welcome Back!</h1>
            <p>Log in to manage your pets, appointments, and more with ease.</p>
        </div>

        <div class="content-panel right-panel">
            <form class="login-form"
                  asp-action="Login"
                  method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <input asp-for="Email" placeholder="Email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input asp-for="Password" type="password" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                @* <button type="submit" class="sign-in-button">SIGN IN</button> *@
                <div class="form-group button-group">
                    <button type="submit" class="sign-in-button">SIGN IN</button>
                    <a asp-controller="PetOwners" asp-action="Create" class="register-button">REGISTER</a>
                </div>
                <div class="form-group text-right">
                    <a asp-controller="Home" asp-action="ForgotPassword" class="forgot-password-link">Forgot Password?</a>
                </div>

            </form>
        </div>
    </div>
</div>
