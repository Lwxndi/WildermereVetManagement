@model IntergratedProject.ViewModels.AppointmentCreateViewModel

@{
    ViewData["Title"] = "Book Appointment";
}

<h2>Book Appointment</h2>

<form asp-action="Create" method="post">
    <!-- Appointment Type -->
    <div class="mb-3">
        <label asp-for="AppointmentTypeId" class="form-label"></label>
        <select asp-for="AppointmentTypeId" class="form-select" asp-items="Model.AppointmentTypes">
            <option value="">-- Select Appointment Type --</option>
        </select>
        <span asp-validation-for="AppointmentTypeId" class="text-danger"></span>
    </div>

    <!-- Price -->
    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" readonly id="Price" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <!-- Veterinarian -->
    <div class="mb-3">
        <label asp-for="VeterinarianId" class="form-label"></label>
        <select asp-for="VeterinarianId" class="form-select" id="VeterinarianId">
            <option value="">-- Select Veterinarian --</option>
            @foreach (var vet in Model.Veterinarians)
            {
                <option value="@vet.Value" data-available="true">@vet.Text</option>
            }
        </select>
        <span asp-validation-for="VeterinarianId" class="text-danger"></span>
        <small id="VetAvailabilityMessage" class="text-muted"></small>
    </div>

    <!-- Pet -->
    <div class="mb-3">
        <label asp-for="PetId" class="form-label"></label>
        <select asp-for="PetId" class="form-select" asp-items="Model.Pets">
            <option value="">-- Select Pet --</option>
        </select>
        <span asp-validation-for="PetId" class="text-danger"></span>
    </div>

    <!-- Date -->
    <div class="mb-3">
        <label asp-for="AppointmentDateTime" class="form-label">Date</label>
        <input type="date" id="AppointmentDate" class="form-control" value="@Model.AppointmentDateTime.ToString("yyyy-MM-dd")" />
    </div>

    <!-- Time -->
    <div class="row mb-3">
        <div class="col">
            <label class="form-label">Hour</label>
            <select id="AppointmentHour" class="form-select">
                @for (int h = 0; h < 24; h++)
                {
                    string selected = (h == Model.AppointmentDateTime.Hour) ? "selected" : "";
                    @:<option value="@h" @selected>@h.ToString("D2")</option>
                }
            </select>
        </div>
        <div class="col">
            <label class="form-label">Minute</label>
            <select id="AppointmentMinute" class="form-select">
                @for (int m = 0; m < 60; m += 5)
                {
                    string selected = (m == Model.AppointmentDateTime.Minute) ? "selected" : "";
                    @:<option value="@m" @selected>@m.ToString("D2")</option>
                }
            </select>
        </div>
    </div>

    <!-- Additional Notes -->
    <div class="mb-3">
        <label asp-for="AdditionalNotes" class="form-label"></label>
        <textarea asp-for="AdditionalNotes" class="form-control"></textarea>
        <span asp-validation-for="AdditionalNotes" class="text-danger"></span>
    </div>

    <!-- Hidden full datetime -->
    <input type="hidden" id="AppointmentDateTime" name="AppointmentDateTime" value="@Model.AppointmentDateTime.ToString("yyyy-MM-ddTHH:mm")" />

    <!-- End Time -->
    <div class="mb-3">
        <label class="form-label">Appointment End Time</label>
        <input type="text" class="form-control" id="EndTime" readonly />
    </div>

    <button type="submit" class="btn btn-primary">Book Appointment</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/appointment.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Update hidden datetime field
        function updateHiddenDateTime() {
            var date = $("#AppointmentDate").val();
            var hour = $("#AppointmentHour").val();
            var minute = $("#AppointmentMinute").val();
            if (date && hour !== null && minute !== null) {
                $("#AppointmentDateTime").val(date + "T" + hour.padStart(2,'0') + ":" + minute.padStart(2,'0'));
            }
        }

        $("#AppointmentDate, #AppointmentHour, #AppointmentMinute").on("change", function () {
            updateHiddenDateTime();
            checkVetAvailability();
            updateEndTime();
        });

        $(document).ready(function() {
            updateHiddenDateTime();
            updateEndTime();
            checkVetAvailability();
        });

        function getCombinedDateTime() {
            var date = $("#AppointmentDate").val();
            var hour = $("#AppointmentHour").val();
            var minute = $("#AppointmentMinute").val();
            if(date && hour !== null && minute !== null){
                return new Date(date + "T" + hour.padStart(2,'0') + ":" + minute.padStart(2,'0'));
            }
            return null;
        }

        function updateEndTime(duration = parseInt($("#AppointmentTypeId option:selected").data("duration")) || 0) {
            var appointmentDateTime = getCombinedDateTime();
            if(appointmentDateTime && duration){
                var end = new Date(appointmentDateTime);
                end.setMinutes(end.getMinutes() + duration);
                $("#EndTime").val(end.getHours().toString().padStart(2,'0') + ':' + end.getMinutes().toString().padStart(2,'0'));
            } else {
                $("#EndTime").val('');
            }
        }

        $("#AppointmentTypeId").change(function () {
            var appointmentTypeId = $(this).val();
            if (appointmentTypeId) {
                $.ajax({
                    url: '/Appointments/GetPrice',
                    type: 'GET',
                    data: { appointmentTypeId: appointmentTypeId },
                    success: function (data) {
                        $("#Price").val(data.price);
                        updateEndTime(data.durationMinutes);
                    },
                    error: function () {
                        $("#Price").val('');
                        $("#EndTime").val('');
                        Swal.fire({ icon: 'error', title: 'Oops!', text: "Could not fetch price." });
                    }
                });
            } else {
                $("#Price").val('');
                $("#EndTime").val('');
            }
        });

        // Vet availability check
        function checkVetAvailability() {
            var dateTime = $("#AppointmentDateTime").val();
            if(!dateTime) return;

            $("#VeterinarianId option").each(function () {
                var vetId = $(this).val();
                if(!vetId) return;

                $.ajax({
                    url: '/Appointments/CheckVetAvailability',
                    type: 'GET',
                    data: { vetId: vetId, appointmentDateTime: dateTime },
                    success: function (res) {
                        if(res.available){
                            $(this).prop('disabled', false).css('color','black');
                        } else {
                            $(this).prop('disabled', true).css('color','gray');
                        }
                        $("#VetAvailabilityMessage").text(res.message || '');
                    }.bind(this),
                    error: function () {
                        $(this).prop('disabled', false).css('color','black');
                    }.bind(this)
                });
            });
        }

        // Show SweetAlert2 for server-side errors/messages
        $(document).ready(function() {
            var errors = [];
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <text>errors.push("@error.ErrorMessage");</text>
            }
            @if(!string.IsNullOrEmpty(ViewBag.VetUnavailableMessage)) { <text>errors.push("@ViewBag.VetUnavailableMessage");</text> }
            @if(!string.IsNullOrEmpty(ViewBag.DoubleBookingMessage)) { <text>errors.push("@ViewBag.DoubleBookingMessage");</text> }
            @if(!string.IsNullOrEmpty(ViewBag.LeadTimeMessage)) { <text>errors.push("@ViewBag.LeadTimeMessage");</text> }

            if(errors.length > 0){
                Swal.fire({ icon: 'error', title: 'Oops!', html: errors.join('<br>'), confirmButtonText: 'OK' });
            }
        });
    </script>
}
