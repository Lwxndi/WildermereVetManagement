@model IntergratedProject.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
    Func<IntergratedProject.Models.PetOwner, string> OwnerFullName = owner =>
        owner == null ? "Unknown" :
        string.Join(" ", new[] { owner.Name, owner.MiddleName, owner.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)));
}

<h2>Delete Appointment</h2>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Are you sure you want to delete this appointment?</h5>

        <dl class="row">
            <dt class="col-sm-3">Pet</dt>
            <dd class="col-sm-9">@Model.Pet?.PetName ?? "Unknown"</dd>

            <dt class="col-sm-3">Owner</dt>
            <dd class="col-sm-9">@OwnerFullName(Model.PetOwner ?? Model.Pet?.PetOwner)</dd>

            <dt class="col-sm-3">Date & Time</dt>
            <dd class="col-sm-9">
                @{
                    var start = Model.Date.Add(Model.Time);
                    var duration = Model.AppointmentType?.DurationMinutes ?? 0;
                    var end = start.AddMinutes(duration);
                }
                @start.ToString("dddd, MMM dd yyyy hh:mm tt") — @end.ToString("hh:mm tt")
            </dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.AppointmentType?.Name ?? "-"</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<form id="deleteForm" asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AppointmentId" />
    <button id="btnDelete" type="button" class="btn btn-danger">Yes, delete appointment</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.getElementById('btnDelete').addEventListener('click', function (e) {
            e.preventDefault();
            Swal.fire({
                title: 'Confirm delete?',
                text: 'This will permanently delete (or mark cancelled) the appointment.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                cancelButtonText: 'No, keep'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();
                }
            });
        });
    </script>

    @* Show TempData popup after redirect if present *@
    @if (TempData["PopupMessage"] != null)
    {
        var popupMsg = Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)TempData["PopupMessage"]));
        var popupType = Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(TempData["PopupType"] ?? "info")));
        <script>
            (function () {
                var msg = @popupMsg;
                var type = @popupType;
                Swal.fire({
                    icon: type === 'error' ? 'error' : (type === 'success' ? 'success' : 'info'),
                    title: type === 'error' ? 'Error' : (type === 'success' ? 'Success' : 'Notice'),
                    html: msg,
                    confirmButtonText: 'OK'
                });
            })();
        </script>
    }
}
