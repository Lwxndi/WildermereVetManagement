@model IntergratedProject.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";

    Func<IntergratedProject.Models.PetOwner, string> OwnerFullName = owner =>
        owner == null ? "Unknown" :
        string.Join(" ", new[] { owner.Name, owner.MiddleName, owner.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)));

    Func<IntergratedProject.Models.Veterinarian, string> VetFullName = vet =>
        vet == null ? "Not assigned" : $"{vet.Name} {vet.LastName}".Trim();

    var role = User.IsInRole("Admin") ? "Admin" :
               User.IsInRole("Veterinarian") ? "Veterinarian" :
               "PetOwner";
}

<h2>Appointment Details</h2>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.AppointmentType?.Name ?? "Appointment"</h5>
        <dl class="row">
            <dt class="col-sm-3">Pet</dt>
            <dd class="col-sm-9">@Model.Pet?.PetName ?? "Unknown"</dd>

            <dt class="col-sm-3">Owner</dt>
            <dd class="col-sm-9">@OwnerFullName(Model.PetOwner ?? Model.Pet?.PetOwner)</dd>

            <dt class="col-sm-3">Veterinarian</dt>
            <dd class="col-sm-9">@VetFullName(Model.Veterinarian)</dd>

            <dt class="col-sm-3">Date & Time</dt>
            <dd class="col-sm-9">
                @{
                    var start = Model.Date.Add(Model.Time);
                    var duration = Model.AppointmentType?.DurationMinutes ?? 0;
                    var end = start.AddMinutes(duration);
                }
                @start.ToString("dddd, MMM dd yyyy hh:mm tt") — @end.ToString("hh:mm tt")
            </dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.AppointmentType?.Name ?? "-"</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">
                @(Model.AppointmentType != null ? Model.AppointmentType.Price.ToString("C") : "-")
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.AdditionalNotes) ? Model.AdditionalNotes : "-")</dd>

            @* Payment info for PetOwner *@
            @if (role == "PetOwner")
            {
                <dt class="col-sm-3">Payment Status</dt>
                <dd class="col-sm-9">
                    @(Model.Payment != null ? Model.Payment.PaymentStatus : "Pending")
                    @if (Model.Payment == null || Model.Payment.PaymentStatus != "Paid")
                    {
                        <span class="text-warning">(Payment required)</span>
                    }
                </dd>
            }
        </dl>
    </div>
</div>

<div class="mb-3">
    @* Role-based actions *@
    @if (role == "PetOwner")
    {
        @* Continue to payment if not paid *@
        @if (Model.Payment == null || Model.Payment.PaymentStatus != "Paid")
        {
            <a asp-controller="Payments" asp-action="Checkout" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-primary">Continue to Payment</a>
        }
        <a asp-action="Reschedule" asp-route-id="@Model.AppointmentId" class="btn btn-warning">Reschedule</a>
        <a asp-action="Cancel" asp-route-id="@Model.AppointmentId" class="btn btn-secondary">Cancel</a>
    }
    else if (role == "Admin")
    {
        <a asp-action="Edit" asp-route-id="@Model.AppointmentId" class="btn btn-secondary">Edit Appointment</a>
        <a asp-action="Cancel" asp-route-id="@Model.AppointmentId" class="btn btn-warning">Cancel</a>
        <a asp-action="Delete" asp-route-id="@Model.AppointmentId" class="btn btn-danger">Delete</a>
    }
    else if (role == "Veterinarian")
    {
        <span class="badge bg-info">Read-only view</span>
    }

    <a asp-action="Index" class="btn btn-light">Back</a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["PopupMessage"] != null)
    {
        var popupMsg = Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)TempData["PopupMessage"]));
        var popupType = Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(TempData["PopupType"] ?? "info")));
        <script>
            (function () {
                var msg = @popupMsg;
                var type = @popupType;
                Swal.fire({
                    icon: type === 'error' ? 'error' : (type === 'success' ? 'success' : 'info'),
                    title: type === 'error' ? 'Error' : (type === 'success' ? 'Success' : 'Notice'),
                    html: msg,
                    confirmButtonText: 'OK'
                });
            })();
        </script>
    }
}
