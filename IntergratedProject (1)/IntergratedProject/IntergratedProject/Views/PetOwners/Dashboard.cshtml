    @*                 <a asp-controller="MedicalRecords" asp-action="Create" class="btn btn-primary btn-lg mt-2">Add Record</a> *@
    @*             </div> *@
    @*         } *@
    @*     </div> *@
    @* </div> *@

</div>

<!-- Chart Section -->
<div class="row mt-5">
    <div class="col-12">
        <div class="dashboard-card p-4">
            <h3 class="fw-bold">Appointments Overview</h3>
            <canvas id="appointmentsChart" height="100"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('appointmentsChart');
        const chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: [
        @Html.Raw(string.Join(",", Model.Appointments?
                     .Select(a => $"'{a.Date:MMM yyyy}'") ?? new List<string>()))
                ],
                datasets: [{
                    label: 'Appointments',
                    data: [
        @Html.Raw(string.Join(",", Model.Appointments?
                     .Select(a => "1") ?? new List<string>()))
                    ],
                    backgroundColor: '#007BFF'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        precision: 0,
                        ticks: { color: '#343A40' },
                        grid: { color: 'rgba(52, 58, 64, 0.1)' }
                    },
                    x: {
                        ticks: { color: '#343A40' },
                        grid: { color: 'rgba(52, 58, 64, 0.1)' }
                    }
                }
            }
        });
    </script>
}
