    @*                .Take(5)) *@
    @*                 { *@
    @*                     <li class="list-group-item d-flex justify-content-between align-items-center dashboard-card"> *@
    @*                         <div> *@
    @*                             <strong>@record.Pet?.PetName</strong> - @record.RecordType *@
    @*                             <div class="small text-muted">@record.Date.ToShortDateString()</div> *@
    @*                         </div> *@
    @*                         <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@record.Id" class="btn btn-sm btn-outline-secondary"> *@
    @*                             View *@
    @*                         </a> *@
    @*                     </li> *@
    @*                 } *@
    @*             </ul> *@
    @*         } *@
    @*         else *@
    @*         { *@
